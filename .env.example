# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase dashboard > Project Settings > API Keys (and Data API for the URL)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...). The legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...). The legacy "service_role" key also works here.
# Server only. Never prefix with NEXT_PUBLIC_ and never commit .env.local.
SUPABASE_SECRET_KEY=

# --- Push notifications (แจ้งเตือนบนมือถือ) ---
# Create the pair once with:  npx web-push generate-vapid-keys
# (สร้างคู่กุญแจครั้งเดียวด้วยคำสั่งข้างบน แล้วคัดลอก Public Key / Private Key มาใส่)
# Public key: safe in the browser. (ส่งไปที่เบราว์เซอร์ได้)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Private key: server only, never prefix with NEXT_PUBLIC_. (เก็บฝั่งเซิร์ฟเวอร์เท่านั้น)
VAPID_PRIVATE_KEY=
# Contact address the push services can reach, e.g. mailto:admin@example.com (อีเมลผู้ดูแลระบบ)
VAPID_SUBJECT=mailto:admin@example.com

# --- Scheduled jobs (งานตามเวลา cron-job.org) ---
# A long random text (16+ characters). cron-job.org sends it as  Authorization: Bearer <CRON_SECRET>
# to /api/cron/tick (every 5 minutes) and /api/cron/daily (once a day, 07:00).
# (ข้อความสุ่มยาวอย่างน้อย 16 ตัว ใส่ใน header ของ cron-job.org)  e.g.  openssl rand -hex 24
CRON_SECRET=

# Project website lead form -> POST /api/leads with header x-api-key: <this value>.
# At least 16 random characters. Server to server only: never put it in browser code.
LEADS_API_KEY=
